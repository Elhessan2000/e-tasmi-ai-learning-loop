# =====================================================================
# Application timezone
# ---------------------------------------------------------------------
# Sets the JVM/system timezone for the Tomcat container.
#
# NOTE: The application no longer depends on the host clock for session
# math. All "Next Up" countdown / upcoming / today / calendar logic is
# anchored in code to util.DateTimeFormats.APP_ZONE, which resolves:
#     APP_TIME_ZONE  ->  TZ  ->  Asia/Kuala_Lumpur (built-in default).
# So even on Railway (which defaults to UTC) the dashboard surfaces the
# correct nearest upcoming session WITHOUT this variable being set.
# Setting TZ is still recommended so OS-level logs match local time.
#
# Override the application zone explicitly with APP_TIME_ZONE if you want
# the math to differ from the OS clock. Examples: Asia/Singapore,
# Asia/Riyadh, Asia/Dubai, Asia/Jakarta, Europe/London, UTC.
# =====================================================================
TZ=Asia/Kuala_Lumpur

# =====================================================================
# Email transport (verification + password reset)
# ---------------------------------------------------------------------
# The app supports two transports. It picks automatically at runtime:
#
#   (A) HTTPS via Resend  --  RECOMMENDED for Railway / any host that
#                             blocks outbound SMTP. Active whenever
#                             RESEND_API_KEY is set. Uses port 443,
#                             which is never blocked.
#
#   (B) SMTP via Gmail    --  Default for local Docker Compose. Active
#                             when RESEND_API_KEY is NOT set.
#
# ---------------------------------------------------------------------
# (A) RESEND SETUP (Railway)
# ---------------------------------------------------------------------
# 1. Sign up free at https://resend.com (no credit card; 3,000 emails/mo).
# 2. Dashboard -> API Keys -> Create API Key. Copy the "re_..." token.
# 3. In Railway -> your service -> Variables, add:
#        RESEND_API_KEY = re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#        SMTP_FROM      = onboarding@resend.dev
#    (You can use onboarding@resend.dev immediately. For production,
#    verify your own domain in Resend -> Domains and set SMTP_FROM
#    to e.g. "no-reply@yourdomain.com".)
# 4. Redeploy. Registration now sends email over HTTPS.
#
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# ---------------------------------------------------------------------
# (B) SMTP SETUP (local)
# ---------------------------------------------------------------------
# For Gmail:
#  - Enable 2-Step Verification on the sending Google account.
#  - Create a Google App Password (https://myaccount.google.com/apppasswords)
#    and paste it as SMTP_PASSWORD (spaces are fine).
#  - SMTP_FROM must equal the Gmail login address (SMTP_USER / SMTP_USERNAME).
#
# NOTE: The .env file in this repo is NOT read by Railway; docker-compose uses it locally.
# For Railway SMTP, set the same variables in the service Variables tab.
#
# Public URL (required for SMTP reset/verification links on Railway).
# Use APP_URL or APP_BASE_URL (APP_URL takes precedence if both are set).
# Example: APP_URL=https://your-service.up.railway.app (https:// added if omitted)
# APP_URL=http://localhost:8080
# =====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
# Use SMTP_USER + SMTP_PASSWORD (or SMTP_PASS / SMTP_USERNAME aliases).
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com
# Optional troubleshooting: verbose SMTP logs in docker logs (true/false).
# SMTP_DEBUG=true
#
# If Gmail SMTP fails from Docker (auth, timeout, or ISP blocks port 587), use
# Resend over HTTPS instead (no SMTP). Free tier: https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=onboarding@resend.dev

# =====================================================================
# Zoom integration
# ---------------------------------------------------------------------
# (1) Server-to-Server OAuth app — meeting create/update/delete via REST
#     (api.zoom.us) and host ZAK tokens. From Marketplace app type
#     "Server-to-Server OAuth".
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-server-to-server-oauth-client-id
ZOOM_CLIENT_SECRET=your-server-to-server-oauth-client-secret
ZOOM_DEFAULT_HOST_EMAIL=licensed-host@yourdomain.com
ZOOM_TIMEZONE=UTC
#
# (2) Meeting SDK app — REQUIRED for in-browser (embedded) meetings.
#     Create a "General App" in the Zoom Marketplace, enable the
#     Meeting SDK feature, and copy that app's Client ID / Client Secret
#     here. These are DIFFERENT credentials from (1) above — signing the
#     join JWT with the OAuth secret makes the embedded join fail.
ZOOM_MEETING_SDK_KEY=your-meeting-sdk-client-id
ZOOM_MEETING_SDK_SECRET=your-meeting-sdk-client-secret
#
# Embedding is ON by default once the SDK credentials above are set.
# Set ZOOM_EMBED_ENABLED=false to force external zoom.us redirects.
# ZOOM_EMBED_ENABLED=true
#
# Optional: override the Zoom Web SDK version loaded from source.zoom.us.
# ZOOM_WEB_SDK_VERSION=3.11.2
# Optional: verbose Zoom Web SDK console logging for troubleshooting.
# ETASMI_ZOOM_WEB_DEBUG=true
# =====================================================================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
OPENAI_API_KEY=your-openai-api-key
# Optional: model for e-Tasmi Quran Assistant chat (defaults to gpt-4o-mini)
# OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# Optional override for transcription model (must support verbose_json for confidence gating).
# Defaults to "whisper-1".
# OPENAI_RECITATION_MODEL=whisper-1
# Optional override for the chat model used to produce the recitation evaluation report
# (Quran-vs-not classification + word-level diff + tajwīd notes + feedback) in a single call.
# Defaults to "gpt-4o-mini". Upgrade to "gpt-4o" for stronger reasoning on tajwīd nuance.
# Back-compat: OPENAI_CLASSIFIER_MODEL is still honored if set.
# OPENAI_EVALUATOR_MODEL=gpt-4o-mini
# --- e-Tasmi Quran Assistant VOICE mode (speech-to-text + text-to-speech) ---
# Optional: speech-to-text model for the voice assistant. Defaults to "gpt-4o-transcribe".
# (Any OpenAI STT model works, e.g. "whisper-1" or "gpt-4o-mini-transcribe".)
# OPENAI_VOICE_STT_MODEL=gpt-4o-transcribe
# Optional: text-to-speech model for spoken replies. Defaults to "gpt-4o-mini-tts".
# (Use "tts-1" or "tts-1-hd" for the legacy TTS models.)
# OPENAI_VOICE_TTS_MODEL=gpt-4o-mini-tts
# Optional: TTS voice name. Defaults to "alloy". Other calm options: "shimmer", "nova", "verse".
# OPENAI_VOICE_NAME=alloy

# Optional (dev/recovery): if set, Tomcat startup resets password for admin@etasmi.com to this value.
# ETASMI_BOOTSTRAP_ADMIN_PASSWORD=Admin123!
#
# Optional (dev only): set true to skip email verification at login. Production: do not set (normal verification).
# ETASMI_ALLOW_LOGIN_WITHOUT_EMAIL_VERIFICATION=true

# =====================================================================
# Database connection
# ---------------------------------------------------------------------
# LOCAL (Docker Compose): handled automatically via JNDI (context.xml).
#
# RAILWAY (or any managed MySQL): set these and the app will build the
# JDBC URL dynamically. Railway exposes them for a linked MySQL service.
# MYSQLHOST=containers-xxx.railway.app
# MYSQLPORT=3306
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=your-railway-password
#
# Alternatively, you can provide an explicit JDBC URL:
# ETASMI_JDBC_URL=jdbc:mysql://host:3306/etasmi?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# ETASMI_JDBC_USER=...
# ETASMI_JDBC_PASSWORD=...
# =====================================================================

# =====================================================================
# Quran Foundation Content API — set real values only in repo-root `.env` (gitignored).
# Backend: QuranFoundationConfig. QF_API_ENDPOINT must be the Content APIs host, not OAuth.
# =====================================================================
QF_ENV=
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_API_ENDPOINT=
# Optional; empty = inferred from QF_ENV (production_live tiers use production OAuth when unset).
# QF_AUTH_ENDPOINT=
