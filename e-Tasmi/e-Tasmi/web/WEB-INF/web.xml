<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>e-Tasmi</display-name>

    <!-- Auto-create the database schema on first boot against an empty DB
         (e.g. Railway). Safe to keep permanently: if tables already exist,
         the listener logs and exits without doing anything. -->
    <listener>
        <listener-class>util.SchemaBootstrap</listener-class>
    </listener>

                <!-- SMTP settings for app emails (e.g., password reset).
                        Configure via Railway / Docker environment variables (required for production):
                            SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD (or SMTP_PASS),
                            SMTP_FROM, APP_URL (or APP_BASE_URL)
                        Or use RESEND_API_KEY + SMTP_FROM when outbound SMTP is blocked.

                        These web.xml context-params are dev fallbacks only; never put secrets here.
                -->
    <context-param>
        <param-name>SMTP_HOST</param-name>
        <param-value>smtp.gmail.com</param-value>
    </context-param>
    <context-param>
        <param-name>SMTP_PORT</param-name>
        <param-value>587</param-value>
    </context-param>
    <context-param>
        <param-name>SMTP_STARTTLS</param-name>
        <param-value>true</param-value>
    </context-param>
    <context-param>
        <param-name>SMTP_USERNAME</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>SMTP_PASSWORD</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>SMTP_FROM</param-name>
        <param-value></param-value>
    </context-param>


    <!-- HomeServlet & InstructorSessionsServlet: url patterns come from @WebServlet only
         (duplicate web.xml servlet + mapping broke Tomcat in some setups). -->

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <mime-mapping>
        <extension>mp4</extension>
        <mime-type>video/mp4</mime-type>
    </mime-mapping>

    <resource-ref>
        <description>e-Tasmi MySQL DataSource</description>
        <res-ref-name>jdbc/ETasmiDS</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>

    <!-- Force JSP compilation using javac (JSR-199) instead of ECJ/JDT.
         This helps avoid JSP compile failures on newer JDKs. -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
        <init-param>
            <param-name>compiler</param-name>
            <param-value>javac</param-value>
        </init-param>
        <init-param>
            <param-name>compilerSourceVM</param-name>
            <param-value>1.8</param-value>
        </init-param>
        <init-param>
            <param-name>compilerTargetVM</param-name>
            <param-value>1.8</param-value>
        </init-param>
        <load-on-startup>3</load-on-startup>
    </servlet>

    <!-- Must be declared FIRST so UTF-8 is applied before any other
         filter/servlet reads request parameters or writes the response. -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>controller.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
        <dispatcher>FORWARD</dispatcher>
        <dispatcher>INCLUDE</dispatcher>
        <dispatcher>ERROR</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>UrlLocalizationFilter</filter-name>
        <filter-class>controller.filter.UrlLocalizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>UrlLocalizationFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <!-- Force UTF-8 for the JSP translation phase. Without this, Jasper
         reads JSP/JSPF sources (saved as UTF-8) as ISO-8859-1, producing
         mojibake such as "Ø§Ù„Ø¹Ø±Ø¨ÙŠØ©" instead of "العربية". -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <default-content-type>text/html; charset=UTF-8</default-content-type>
        </jsp-property-group>
    </jsp-config>

    <servlet-mapping>
        <servlet-name>jsp</servlet-name>
        <url-pattern>*.jsp</url-pattern>
    </servlet-mapping>

</web-app>
