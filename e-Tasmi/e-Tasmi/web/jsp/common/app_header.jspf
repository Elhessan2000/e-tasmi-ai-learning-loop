<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>

<%@ page import="util.LocaleSupport" %>

<%

  Object headerDisplayNameObj = session.getAttribute("displayName");

  String headerDisplayName = (headerDisplayNameObj == null) ? "Account" : String.valueOf(headerDisplayNameObj);

%>

<div class="topbar">

  <a class="brand" href="<%= LocaleSupport.localizedUrl(request, "/dashboard") %>" aria-label="e-Tasmi">

    <img src="<%= request.getContextPath() %>/assets/img/logo.svg" alt="e-Tasmi" />

    <span class="name">e-Tasmi</span>

  </a>

  <div class="app-header-actions">

    <span class="pill"><%= headerDisplayName %></span>

    <a class="btn btn-ghost" href="<%= LocaleSupport.localizedUrl(request, "/dashboard") %>" data-i18n="dashboard.dashboard">Dashboard</a>

    <a class="btn btn-ghost" href="<%= LocaleSupport.localizedUrl(request, "/notifications") %>" data-i18n="student.nav.notifications">Notifications</a>

    <button class="etasmi-theme-toggle" type="button" data-etasmi-theme-toggle

      aria-label="Switch to dark mode" title="Switch to dark mode">

      <svg class="etasmi-theme-toggle__moon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">

        <path d="M20 15.5A7.5 7.5 0 0 1 8.5 4a8.5 8.5 0 1 0 11.5 11.5Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>

      </svg>

      <svg class="etasmi-theme-toggle__sun" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">

        <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/>

        <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4 7 17M17 7l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>

      </svg>

    </button>

    <a class="btn btn-ghost" href="<%= LocaleSupport.localizedUrl(request, "/auth/logout") %>" data-i18n="student.nav.logout">Logout</a>

  </div>

</div>

