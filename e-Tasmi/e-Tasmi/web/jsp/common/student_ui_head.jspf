<%@ include file="/jsp/common/etasmi_i18n_head.jspf" %>
<script>
  (function(){
    try{
      var c = localStorage.getItem('etasmi-student-nav-collapsed');
      if (c === '1' && window.matchMedia && window.matchMedia('(min-width: 1101px)').matches){
        document.documentElement.setAttribute('data-student-nav', 'collapsed');
      }
    }catch(e){}
  })();
</script>
