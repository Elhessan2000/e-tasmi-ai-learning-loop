<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %>
<%@ page import="util.LocaleSupport" %>
<%
  Object instructorSidebarActiveObj = request.getAttribute("activeMenu");
  String instructorSidebarActiveMenu = (instructorSidebarActiveObj == null) ? "" : String.valueOf(instructorSidebarActiveObj);
%>
<div class="instructor-shell-sidebar__scrim" data-instructor-nav-dismiss></div>
<aside class="instructor-shell-sidebar" id="instructorWorkspaceSidebar" data-instructor-sidebar
  aria-label="Instructor navigation" data-i18n="instructor.sidebar.aria" data-i18n-attr="aria-label">
  <div class="instructor-shell-sidebar__panel">

    <%-- ── Navigation ─────────────────────────────────────────────── --%>
    <nav class="instructor-shell-sidebar__nav" aria-label="Instructor navigation"
      data-i18n="instructor.sidebar.navAria" data-i18n-attr="aria-label">

      <a class="instructor-shell-sidebar__link <%= "overview".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/instructor/dashboard") %>"
        data-tooltip="Dashboard" data-i18n="instructor.nav.dashboard" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="3" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
            <rect x="14" y="3" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
            <rect x="14" y="12" width="7" height="9" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
            <rect x="3" y="16" width="7" height="5" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.dashboard">Dashboard</span>
      </a>

      <a class="instructor-shell-sidebar__link <%= "sessions".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/instructor/sessions") %>"
        data-tooltip="Sessions" data-i18n="instructor.nav.sessions" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.7"/>
            <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
            <path d="M12 14v4M10 16h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.sessions">Sessions</span>
      </a>

      <a class="instructor-shell-sidebar__link <%= "payments".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/instructor/payments") %>"
        data-tooltip="Payments" data-i18n="instructor.nav.payments" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.7"/>
            <path d="M3 10h18" stroke="currentColor" stroke-width="1.7"/>
            <path d="M7 15h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.payments">Payments</span>
      </a>

      <a class="instructor-shell-sidebar__link <%= "evaluations".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/instructor/evaluations") %>"
        data-tooltip="Evaluations" data-i18n="instructor.nav.evaluations" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 5a2 2 0 0 1 2-2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V5Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
            <path d="M14 3v5h5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.evaluations">Evaluations</span>
      </a>

      <a class="instructor-shell-sidebar__link <%= "notifications".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/notifications") %>"
        data-tooltip="Notifications" data-i18n="student.nav.notifications" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 17H9m9-1.5V10a6 6 0 1 0-12 0v5.5L4.5 17v1h15v-1L18 15.5Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M10 19a2 2 0 0 0 4 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="student.nav.notifications">Notifications</span>
      </a>

      <a class="instructor-shell-sidebar__link <%= "profile".equals(instructorSidebarActiveMenu) ? "is-active" : "" %>"
        href="<%= LocaleSupport.localizedUrl(request, "/instructor/profile") %>"
        data-tooltip="Profile" data-i18n="instructor.nav.profile" data-i18n-attr="aria-label|data-tooltip">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.7"/>
            <path d="M4 21a8 8 0 0 1 16 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.profile">Profile</span>
      </a>
    </nav>

    <%-- ── Logout ──────────────────────────────────────────────────── --%>
    <div class="instructor-shell-sidebar__footer">
      <a class="instructor-shell-sidebar__logout"
        href="<%= LocaleSupport.localizedUrl(request, "/auth/logout") %>"
        data-tooltip="Logout" data-i18n="instructor.nav.logout" data-i18n-attr="aria-label" aria-label="Logout">
        <span class="instructor-shell-sidebar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="m10 17-5-5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M5 12h11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="instructor-shell-sidebar__label" data-i18n="instructor.nav.logout">Logout</span>
      </a>
    </div>

  </div>
</aside>
