{
  "edition": "quran-uthmani",
  "source": "Tanzil canonical Uthmani text. Bundled offline for guaranteed availability.",
  "note": "First ayah of every surah except Al-Fatihah and At-Tawbah includes the Basmalah prefix; the renderer detects and displays it as a separate header.",
  "surahs": {
    "1": {
      "number": 1,
      "ayahs": [
        {"number": 1, "text": "\ufeff\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650"},
        {"number": 2, "text": "\u0671\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0651\u064e\u0647\u0650 \u0631\u064e\u0628\u0651\u0650 \u0671\u0644\u0652\u0639\u064e\u0670\u0644\u064e\u0645\u0650\u064a\u0646\u064e"},
        {"number": 3, "text": "\u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650"},
        {"number": 4, "text": "\u0645\u064e\u0670\u0644\u0650\u0643\u0650 \u064a\u064e\u0648\u0652\u0645\u0650 \u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650"},
        {"number": 5, "text": "\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0639\u0652\u0628\u064f\u062f\u064f \u0648\u064e\u0625\u0650\u064a\u0651\u064e\u0627\u0643\u064e \u0646\u064e\u0633\u0652\u062a\u064e\u0639\u0650\u064a\u0646\u064f"},
        {"number": 6, "text": "\u0671\u0647\u0652\u062f\u0650\u0646\u064e\u0627 \u0671\u0644\u0635\u0651\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u0652\u0645\u064f\u0633\u0652\u062a\u064e\u0642\u0650\u064a\u0645\u064e"},
        {"number": 7, "text": "\u0635\u0650\u0631\u064e\u0670\u0637\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0623\u064e\u0646\u0652\u0639\u064e\u0645\u0652\u062a\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u063a\u064e\u064a\u0652\u0631\u0650 \u0671\u0644\u0652\u0645\u064e\u063a\u0652\u0636\u064f\u0648\u0628\u0650 \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0648\u064e\u0644\u064e\u0627 \u0671\u0644\u0636\u0651\u064e\u0627\u0653\u0644\u0651\u0650\u064a\u0646\u064e"}
      ]
    },
    "103": {
      "number": 103,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0648\u064e\u0671\u0644\u0652\u0639\u064e\u0635\u0652\u0631\u0650"},
        {"number": 2, "text": "\u0625\u0650\u0646\u0651\u064e \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064e\u0670\u0646\u064e \u0644\u064e\u0641\u0650\u0649 \u062e\u064f\u0633\u0652\u0631\u064d"},
        {"number": 3, "text": "\u0625\u0650\u0644\u0651\u064e\u0627 \u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0621\u064e\u0627\u0645\u064e\u0646\u064f\u0648\u0627\u06df \u0648\u064e\u0639\u064e\u0645\u0650\u0644\u064f\u0648\u0627\u06df \u0671\u0644\u0635\u0651\u064e\u0670\u0644\u0650\u062d\u064e\u0670\u062a\u0650 \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u0652\u0627\u06df \u0628\u0650\u0671\u0644\u0652\u062d\u064e\u0642\u0651\u0650 \u0648\u064e\u062a\u064e\u0648\u064e\u0627\u0635\u064e\u0648\u0652\u0627\u06df \u0628\u0650\u0671\u0644\u0635\u0651\u064e\u0628\u0652\u0631\u0650"}
      ]
    },
    "105": {
      "number": 105,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0623\u064e\u0644\u064e\u0645\u0652 \u062a\u064e\u0631\u064e \u0643\u064e\u064a\u0652\u0641\u064e \u0641\u064e\u0639\u064e\u0644\u064e \u0631\u064e\u0628\u0651\u064f\u0643\u064e \u0628\u0650\u0623\u064e\u0635\u0652\u062d\u064e\u0670\u0628\u0650 \u0671\u0644\u0652\u0641\u0650\u064a\u0644\u0650"},
        {"number": 2, "text": "\u0623\u064e\u0644\u064e\u0645\u0652 \u064a\u064e\u062c\u0652\u0639\u064e\u0644\u0652 \u0643\u064e\u064a\u0652\u062f\u064e\u0647\u064f\u0645\u0652 \u0641\u0650\u0649 \u062a\u064e\u0636\u0652\u0644\u0650\u064a\u0644\u064d\u06e2"},
        {"number": 3, "text": "\u0648\u064e\u0623\u064e\u0631\u0652\u0633\u064e\u0644\u064e \u0639\u064e\u0644\u064e\u064a\u0652\u0647\u0650\u0645\u0652 \u0637\u064e\u064a\u0652\u0631\u064b\u0627 \u0623\u064e\u0628\u064e\u0627\u0628\u0650\u064a\u0644\u064e"},
        {"number": 4, "text": "\u062a\u064e\u0631\u0652\u0645\u0650\u064a\u0647\u0650\u0645 \u0628\u0650\u062d\u0650\u062c\u064e\u0627\u0631\u064e\u0629\u064d\u06e2 \u0645\u0651\u0650\u0646 \u0633\u0650\u062c\u0651\u0650\u064a\u0644\u064d\u06e2"},
        {"number": 5, "text": "\u0641\u064e\u062c\u064e\u0639\u064e\u0644\u064e\u0647\u064f\u0645\u0652 \u0643\u064e\u0639\u064e\u0635\u0652\u0641\u064d\u06e2 \u0645\u0651\u064e\u0623\u0652\u0643\u064f\u0648\u0644\u064d\u06ed"}
      ]
    },
    "106": {
      "number": 106,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0644\u0650\u0625\u0650\u064a\u0644\u064e\u0670\u0641\u0650 \u0642\u064f\u0631\u064e\u064a\u0652\u0634\u064d"},
        {"number": 2, "text": "\u0625\u0650\u06e6\u0644\u064e\u0670\u0641\u0650\u0647\u0650\u0645\u0652 \u0631\u0650\u062d\u0652\u0644\u064e\u0629\u064e \u0671\u0644\u0634\u0651\u0650\u062a\u064e\u0627\u0653\u0621\u0650 \u0648\u064e\u0671\u0644\u0635\u0651\u064e\u064a\u0652\u0641\u0650"},
        {"number": 3, "text": "\u0641\u064e\u0644\u0652\u064a\u064e\u0639\u0652\u0628\u064f\u062f\u064f\u0648\u0627\u06df \u0631\u064e\u0628\u0651\u064e \u0647\u064e\u0670\u0630\u064e\u0627 \u0671\u0644\u0652\u0628\u064e\u064a\u0652\u062a\u0650"},
        {"number": 4, "text": "\u0671\u0644\u0651\u064e\u0630\u0650\u0649\u0653 \u0623\u064e\u0637\u0652\u0639\u064e\u0645\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646 \u062c\u064f\u0648\u0639\u064d\u06e2 \u0648\u064e\u0621\u064e\u0627\u0645\u064e\u0646\u064e\u0647\u064f\u0645 \u0645\u0651\u0650\u0646\u0652 \u062e\u064e\u0648\u0652\u0641\u064d\u06ed"}
      ]
    },
    "107": {
      "number": 107,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0623\u064e\u0631\u064e\u0621\u064e\u064a\u0652\u062a\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u064a\u064f\u0643\u064e\u0630\u0651\u0650\u0628\u064f \u0628\u0650\u0671\u0644\u062f\u0651\u0650\u064a\u0646\u0650"},
        {"number": 2, "text": "\u0641\u064e\u0630\u064e\u0670\u0644\u0650\u0643\u064e \u0671\u0644\u0651\u064e\u0630\u0650\u0649 \u064a\u064e\u062f\u064f\u0639\u0651\u064f \u0671\u0644\u0652\u064a\u064e\u062a\u0650\u064a\u0645\u064e"},
        {"number": 3, "text": "\u0648\u064e\u0644\u064e\u0627 \u064a\u064e\u062d\u064f\u0636\u0651\u064f \u0639\u064e\u0644\u064e\u0649\u0670 \u0637\u064e\u0639\u064e\u0627\u0645\u0650 \u0671\u0644\u0652\u0645\u0650\u0633\u0652\u0643\u0650\u064a\u0646\u0650"},
        {"number": 4, "text": "\u0641\u064e\u0648\u064e\u064a\u0652\u0644\u064c\u06ed \u0644\u0651\u0650\u0644\u0652\u0645\u064f\u0635\u064e\u0644\u0651\u0650\u064a\u0646\u064e"},
        {"number": 5, "text": "\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u0652 \u0639\u064e\u0646 \u0635\u064e\u0644\u064e\u0627\u062a\u0650\u0647\u0650\u0645\u0652 \u0633\u064e\u0627\u0647\u064f\u0648\u0646\u064e"},
        {"number": 6, "text": "\u0671\u0644\u0651\u064e\u0630\u0650\u064a\u0646\u064e \u0647\u064f\u0645\u0652 \u064a\u064f\u0631\u064e\u0627\u0653\u0621\u064f\u0648\u0646\u064e"},
        {"number": 7, "text": "\u0648\u064e\u064a\u064e\u0645\u0652\u0646\u064e\u0639\u064f\u0648\u0646\u064e \u0671\u0644\u0652\u0645\u064e\u0627\u0639\u064f\u0648\u0646\u064e"}
      ]
    },
    "108": {
      "number": 108,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0625\u0650\u0646\u0651\u064e\u0627\u0653 \u0623\u064e\u0639\u0652\u0637\u064e\u064a\u0652\u0646\u064e\u0670\u0643\u064e \u0671\u0644\u0652\u0643\u064e\u0648\u0652\u062b\u064e\u0631\u064e"},
        {"number": 2, "text": "\u0641\u064e\u0635\u064e\u0644\u0651\u0650 \u0644\u0650\u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0648\u064e\u0671\u0646\u0652\u062d\u064e\u0631\u0652"},
        {"number": 3, "text": "\u0625\u0650\u0646\u0651\u064e \u0634\u064e\u0627\u0646\u0650\u0626\u064e\u0643\u064e \u0647\u064f\u0648\u064e \u0671\u0644\u0652\u0623\u064e\u0628\u0652\u062a\u064e\u0631\u064f"}
      ]
    },
    "109": {
      "number": 109,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0642\u064f\u0644\u0652 \u064a\u064e\u0670\u0653\u0623\u064e\u064a\u0651\u064f\u0647\u064e\u0627 \u0671\u0644\u0652\u0643\u064e\u0670\u0641\u0650\u0631\u064f\u0648\u0646\u064e"},
        {"number": 2, "text": "\u0644\u064e\u0627\u0653 \u0623\u064e\u0639\u0652\u0628\u064f\u062f\u064f \u0645\u064e\u0627 \u062a\u064e\u0639\u0652\u0628\u064f\u062f\u064f\u0648\u0646\u064e"},
        {"number": 3, "text": "\u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064f\u0645\u0652 \u0639\u064e\u0670\u0628\u0650\u062f\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u0639\u0652\u0628\u064f\u062f\u064f"},
        {"number": 4, "text": "\u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0646\u064e\u0627\u06e0 \u0639\u064e\u0627\u0628\u0650\u062f\u064c\u06ed \u0645\u0651\u064e\u0627 \u0639\u064e\u0628\u064e\u062f\u062a\u0651\u064f\u0645\u0652"},
        {"number": 5, "text": "\u0648\u064e\u0644\u064e\u0627\u0653 \u0623\u064e\u0646\u062a\u064f\u0645\u0652 \u0639\u064e\u0670\u0628\u0650\u062f\u064f\u0648\u0646\u064e \u0645\u064e\u0627\u0653 \u0623\u064e\u0639\u0652\u0628\u064f\u062f\u064f"},
        {"number": 6, "text": "\u0644\u064e\u0643\u064f\u0645\u0652 \u062f\u0650\u064a\u0646\u064f\u0643\u064f\u0645\u0652 \u0648\u064e\u0644\u0650\u0649\u064e \u062f\u0650\u064a\u0646\u0650"}
      ]
    },
    "110": {
      "number": 110,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u0625\u0650\u0630\u064e\u0627 \u062c\u064e\u0627\u0653\u0621\u064e \u0646\u064e\u0635\u0652\u0631\u064f \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0648\u064e\u0671\u0644\u0652\u0641\u064e\u062a\u0652\u062d\u064f"},
        {"number": 2, "text": "\u0648\u064e\u0631\u064e\u0623\u064e\u064a\u0652\u062a\u064e \u0671\u0644\u0646\u0651\u064e\u0627\u0633\u064e \u064a\u064e\u062f\u0652\u062e\u064f\u0644\u064f\u0648\u0646\u064e \u0641\u0650\u0649 \u062f\u0650\u064a\u0646\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0623\u064e\u0641\u0652\u0648\u064e\u0627\u062c\u064b\u06ed\u0627"},
        {"number": 3, "text": "\u0641\u064e\u0633\u064e\u0628\u0651\u0650\u062d\u0652 \u0628\u0650\u062d\u064e\u0645\u0652\u062f\u0650 \u0631\u064e\u0628\u0651\u0650\u0643\u064e \u0648\u064e\u0671\u0633\u0652\u062a\u064e\u063a\u0652\u0641\u0650\u0631\u0652\u0647\u064f \u06da \u0625\u0650\u0646\u0651\u064e\u0647\u064f\u06e5 \u0643\u064e\u0627\u0646\u064e \u062a\u064e\u0648\u0651\u064e\u0627\u0628\u064b\u06e2\u0627"}
      ]
    },
    "111": {
      "number": 111,
      "ayahs": [
        {"number": 1, "text": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0671\u0644\u0644\u0651\u064e\u0647\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0652\u0645\u064e\u0670\u0646\u0650 \u0671\u0644\u0631\u0651\u064e\u062d\u0650\u064a\u0645\u0650 \u062a\u064e\u0628\u0651\u064e\u062a\u0652 \u064a\u064e\u062f\u064e\u0627\u0653 \u0623\u064e\u0628\u0650\u0649 \u0644\u064e\u0647\u064e\u0628\u064d\u06e2 \u0648\u064e\u062a\u064e\u0628\u0651\u064e"},
        {"number": 2, "text": "\u0645\u064e\u0627\u0653 \u0623\u064e\u063a\u0652\u0646\u064e\u0649\u0670 \u0639\u064e\u0646\u0652\u0647\u064f \u0645\u064e\u0627\u0644\u064f\u0647\u064f\u06e5 \u0648\u064e\u0645\u064e\u0627 \u0643\u064e\u0633\u064e\u0628\u064e"},
        {"number": 3, "text": "\u0633\u064e\u064a\u064e\u0635\u0652\u0644\u064e\u0649\u0670 \u0646\u064e\u0627\u0631\u064b\u06ed\u0627 \u0630\u064e\u0627\u062a\u064e \u0644\u064e\u0647\u064e\u0628\u064d\u06e2"},
        {"number": 4, "text": "\u0648\u064e\u0671\u0645\u0652\u0631\u064e\u0623\u064e\u062a\u064f\u0647\u064f\u06e5 \u062d\u064e\u0645\u0651\u064e\u0627\u0644\u064e\u0629\u064e \u0671\u0644\u0652\u062d\u064e\u0637\u064e\u0628\u0650"},
        {"number": 5, "text": "\u0641\u0650\u0649 \u062c\u0650\u064a\u062f\u0650\u0647\u064e\u0627 \u062d\u064e\u0628\u0652\u0644\u064c\u06ed \u0645\u0651\u0650\u0646 \u0645\u0651\u064e\u0633\u064e\u062f\u064d\u06ed"}
      ]
    },
    "112": {
      "number": 112,
      "ayahs": [
